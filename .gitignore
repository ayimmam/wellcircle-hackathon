# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.venv/
venv/
.env
# `.env` alone does not match `.env.local` — which is what Vercel CLI writes,
# carrying BOT_API_KEY and a live OIDC token.
.env.*
!.env.example
# Vercel CLI project linkage (project/org ids), regenerated by `vercel link`.
.vercel/
# Node
node_modules/
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Misc
*.log
opencode.json
WellaTribe_PRD_Hackathon.docx

# Local databases & test artifacts
*.db
*.sqlite3
pytest_output.txt
coverage/
.coverage

# Load test run output
backend/loadtest/results-*.csv
backend/loadtest/*.html

# Saved third-party web pages ("Save Page As" dumps used for research).
# These drag megabytes of someone else's assets into the repo, and the vendor
# scripts inside them trip secret scanners on keys that are not ours — the
# IDS FX Spa dump tripped GitGuardian on Google's public AMP key baked into
# analytics.js. Keep the findings in a markdown doc instead.
*_files/
