# ===========================================
# Well Circle Frontend — Production (wellcircle.et)
# ===========================================

# Same-origin API — backend is at /api on the same domain
VITE_API_BASE_URL=/api

# Disable mock mode
VITE_USE_MOCK=false
VITE_MOCK_SUPER_ADMIN=false

# Bot username for Telegram Login Widget on /provider-portal/login
# and circle invite deep links (t.me/WellCircleBot?startapp=circle_{code})
VITE_BOT_USERNAME=WellCircleBot

# Standalone web app URL — where /visit sends visitors who answer "no" to the
# Telegram question. Must be a different origin than this build: this one is
# the Mini App and its auth requires Telegram initData.
VITE_WEB_APP_URL=https://app.wellcircle.et

# PostHog analytics (set your key here, or leave blank to disable)
VITE_POSTHOG_KEY=phc_oE4L36h9brsbKJ9gtCFGc4MmaigAXesqiQ3i6inqoHB6
VITE_POSTHOG_HOST=https://us.i.posthog.com
