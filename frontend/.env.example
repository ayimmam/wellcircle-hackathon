# Backend API URL (optional — production defaults to same-origin /api proxy)
# Local direct backend: http://localhost:8000/api
# Local via Vite proxy:  /api  (with backend running or proxy target in vite.config.js)
# Vercel production: leave unset (uses /api → backend rewrite in vercel.json)
VITE_API_BASE_URL=http://localhost:8000/api

# true = mock data (local dev without backend); false = production/Telegram
VITE_USE_MOCK=false

# Local testing: grant mock user admin access without DB changes
VITE_MOCK_SUPER_ADMIN=false

# Optional: comma-separated Telegram IDs treated as super admin in frontend guard
# (should match backend SUPER_ADMIN_TELEGRAM_IDS)
VITE_SUPER_ADMIN_TELEGRAM_IDS=

# Bot username (no @) for circle invite deep links (t.me/{username}?startapp=circle_{code})
# and for the Telegram Login Widget on /provider-portal/login. The widget also
# requires this domain to be registered with BotFather via /setdomain (HTTPS only —
# it will not render on localhost).
VITE_BOT_USERNAME=WellCircleBot

# Standalone web app URL — where /visit sends visitors who answer "no" to the
# Telegram question. Must be a different origin than this build: this one is
# the Mini App and its auth requires Telegram initData.
VITE_WEB_APP_URL=https://app.wellcircle.et

# PostHog analytics (leave unset to disable — all tracking calls become no-ops)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
