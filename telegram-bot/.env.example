# Well Circle Telegram Bot

## Environment Variables
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
BACKEND_URL=https://wellcircle-hackathon-backend.vercel.app
BOT_API_KEY=same_secret_as_backend
MINI_APP_URL=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app
SUPER_ADMIN_TELEGRAM_IDS=123456789

# Keeps the Vercel backend resident so users don't hit cold starts.
# Set KEEP_WARM_ENABLED=false when running the bot against a local backend.
KEEP_WARM_ENABLED=true
KEEP_WARM_INTERVAL_SECONDS=270
