# Groq (LLM) — required
GROQ_API_KEY=your_groq_api_key

# Supabase (live provider data) — required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key

# User JWT verification — must match the main FastAPI backend. Required for
# signed-in Telegram Mini App / website users.
JWT_SECRET=your_backend_jwt_secret
JWT_ALGORITHM=HS256

# Anonymous sessions. Optional dedicated secret; when omitted, a separate key
# is derived from JWT_SECRET. TTL is in hours (default 30 days).
ANON_SESSION_SECRET=
ANON_SESSION_TTL_HOURS=720

# Optional tuning (defaults shown)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_SECONDS=20
PROVIDER_CACHE_TTL_SECONDS=60
EVENT_WINDOW_DAYS=30
# Conversation memory. Invalid or out-of-range values fall back to these
# defaults at startup (MEMORY_MAX_MESSAGES must be >= 2).
MEMORY_INACTIVITY_HOURS=24
MEMORY_MAX_MESSAGES=5
MEMORY_CACHE_MAX_SESSIONS=1000
PORT=8000
